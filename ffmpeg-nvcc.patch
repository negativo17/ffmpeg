+        nvccflags_default="-gencode arch=compute_75,code=sm_75 -O2"
     fi
     if $nvcc $nvccflags_default 2>&1 | grep -qi unsupported; then
         nvccflags_default="-gencode arch=compute_75,code=sm_75 -O2"
@@ -7108,7 +7108,7 @@
     nvccflags=$nvccflags_default
 fi
 
