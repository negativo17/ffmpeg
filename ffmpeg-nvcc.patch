diff -Naur ffmpeg-8.1.2.old/configure ffmpeg-8.1.2/configure
--- ffmpeg-8.1.2.old/configure	2026-09-14 18:33:00.723231803 +0200
+++ ffmpeg-8.1.2/configure	2026-09-14 18:33:00.884190334 +0200
@@ -4984,7 +4984,7 @@
 
 if enabled cuda_nvcc; then
     if $nvcc $nvccflags_default 2>&1 | grep -qi unsupported; then
